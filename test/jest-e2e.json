{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "fixture\\.qa\\.e2e-spec\\.ts$"],
  "globalSetup": "<rootDir>/test/support/e2e-global-setup.ts",
  "globalTeardown": "<rootDir>/test/support/e2e-global-teardown.ts",
  "setupFiles": ["<rootDir>/test/support/hermetic.ts"],
  "setupFilesAfterEnv": ["<rootDir>/test/setup-e2e-isolation.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@common/(.*)$": "<rootDir>/src/common/$1",
    "^@users/(.*)$": "<rootDir>/src/users/$1",
    "^@auth/(.*)$": "<rootDir>/src/auth/$1",
    "^@services/(.*)$": "<rootDir>/src/services/$1",
    "^@jobs/(.*)$": "<rootDir>/src/jobs/$1",
    "^@artisans/(.*)$": "<rootDir>/src/artisans/$1",
    "^@messages/(.*)$": "<rootDir>/src/messages/$1",
    "^@notifications/(.*)$": "<rootDir>/src/notifications/$1",
    "^mail/(.*)$": "<rootDir>/src/mail/$1",
    "^config/(.*)$": "<rootDir>/src/config/$1"
  },
  "collectCoverageFrom": [
    "src/**/*.controller.ts",
    "src/**/*.service.ts",
    "!src/main.ts",
    "!src/**/*.module.ts"
  ]
}
