# Saved payment methods (customers) — field encryption for saved mobile money
# numbers and card authorization codes (AES-256-GCM).
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Optional: when unset, the app still starts and saving/paying with saved
# methods is switched off (those endpoints answer 503).
PAYMENT_DATA_ENCRYPTION_KEY=
# Optional, only while rotating: the previous key, so values written with it
# can still be read. New values always use PAYMENT_DATA_ENCRYPTION_KEY.
PAYMENT_DATA_ENCRYPTION_KEY_PREVIOUS=

# Optional rate limits (defaults shown).
# PAYMENT_METHOD_LOOKUP_RATE_LIMIT_PER_10_MINUTES=10
# PAYMENT_METHODS_WRITE_RATE_LIMIT_PER_10_MINUTES=20
# PAYMENT_CHARGE_RATE_LIMIT_PER_10_MINUTES=10
# PAYMENT_CHARGE_STATUS_RATE_LIMIT_PER_MINUTE=60

# ── Auth v2: email codes and Cloudflare Turnstile ─────────────────────────
# Secret for the 6-digit sign-up / login / password-reset codes. Codes and
# addresses are stored only as HMAC-SHA-256 values keyed from this. Optional:
# when unset, keys are derived from SESSION_COOKIE_SECRET (one startup
# warning); production refuses to start with neither. Rotating it voids any
# live code (10 minutes' worth). Generate with:  openssl rand -base64 48
AUTH_CODE_SECRET=

# Cloudflare Turnstile (bot check on register, every code request, forgot
# password, and password login after 3 failures). Get the keys from the
# Cloudflare dashboard → Turnstile → Add site (hostname of the web app,
# widget mode "Managed" or "Invisible") → the site key goes to the frontend
# as NEXT_PUBLIC_TURNSTILE_SITE_KEY, the secret key goes here.
# Unset = checks skipped, with one startup warning (dev/test only).
# Fail-closed: if Cloudflare can't be reached the guarded request gets
# 503 TURNSTILE_UNAVAILABLE.
TURNSTILE_SECRET_KEY=
# Optional: refuse tokens issued for any other hostname (e.g. app.jinva.com).
TURNSTILE_EXPECTED_HOSTNAME=
# Optional: siteverify timeout in milliseconds (default 3000).
# TURNSTILE_TIMEOUT_MS=3000
# Optional: minimum response time in ms for register, code/request and
# password/forgot, so answers for known and unknown addresses line up (default 400).
# AUTH_RESPONSE_FLOOR_MS=400
